<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="7dp" android:paddingBottom="7dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/phyloName" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:fontFamily="monospace" android:textSize="12sp" android:textColor="@color/bright"/>
        <TextView android:id="@+id/phyloRight" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:fontFamily="monospace" android:textSize="10sp" android:textColor="@color/amber"/>
    </LinearLayout>
    <TextView android:id="@+id/phyloSub" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="2"
        android:ellipsize="end" android:fontFamily="monospace" android:textSize="9sp"
        android:textColor="@color/text_dim"/>
</LinearLayout>
