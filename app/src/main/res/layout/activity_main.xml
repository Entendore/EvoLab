<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="14dp" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/gemsView" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:fontFamily="monospace"
                android:textStyle="bold" android:textSize="30sp" android:textColor="@color/bright"/>
            <TextView android:id="@+id/gpsView" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:fontFamily="monospace" android:textSize="11sp" android:textColor="@color/text_dim"/>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:orientation="vertical" android:gravity="end">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textSize="10sp" android:letterSpacing="0.15"
                android:text="TAP YIELD" android:textColor="@color/text_dim"/>
            <TextView android:id="@+id/tapView" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:fontFamily="monospace"
                android:textSize="20sp" android:textColor="@color/amber"/>
            <TextView android:id="@+id/ascendBtn" android:layout_width="wrap_content"
                android:layout_height="30dp" android:minWidth="96dp" android:layout_marginTop="6dp"
                android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp"
                android:background="@drawable/bg_btn" android:clickable="true" android:focusable="true"
                android:fontFamily="monospace" android:textSize="10sp" android:letterSpacing="0.1"
                android:text="DNA 0" android:textColor="@color/text_dim"/>
        </LinearLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:background="@color/line"/>

    <TextView android:id="@+id/statsView" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="8dp" android:fontFamily="monospace" android:textSize="11sp"
        android:letterSpacing="0.05" android:textColor="@color/text_dim"/>

    <TextView android:id="@+id/eventView" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="3dp" android:maxLines="1" android:ellipsize="end"
        android:fontFamily="monospace" android:textSize="10sp" android:textColor="@color/text_dim"/>

    <TextView android:id="@+id/missionView" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="2dp" android:maxLines="2" android:fontFamily="monospace"
        android:textSize="10sp" android:textColor="@color/text_dim"/>

    <com.evolab.game.CoreView android:id="@+id/core"
        android:layout_width="match_parent" android:layout_height="188dp"/>

    <TextView android:id="@+id/feedView" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:minHeight="50dp" android:maxLines="3" android:fontFamily="monospace"
        android:textSize="10sp" android:lineSpacingExtra="4dp" android:textColor="@color/text_dim"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="4dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/tabStock" android:layout_width="0dp" android:layout_height="38dp"
            android:layout_weight="1" android:gravity="center" android:clickable="true"
            android:focusable="true" android:fontFamily="monospace" android:textSize="11sp"
            android:letterSpacing="0.1" android:text="STOCK" android:background="@drawable/bg_btn"
            android:textColor="@color/text_dim"/>
        <Space android:layout_width="7dp" android:layout_height="1dp"/>
        <TextView android:id="@+id/tabTree" android:layout_width="0dp" android:layout_height="38dp"
            android:layout_weight="1" android:gravity="center" android:clickable="true"
            android:focusable="true" android:fontFamily="monospace" android:textSize="11sp"
            android:letterSpacing="0.1" android:text="TREE" android:background="@drawable/bg_btn"
            android:textColor="@color/text_dim"/>
        <Space android:layout_width="7dp" android:layout_height="1dp"/>
        <TextView android:id="@+id/tabLab" android:layout_width="0dp" android:layout_height="38dp"
            android:layout_weight="1" android:gravity="center" android:clickable="true"
            android:focusable="true" android:fontFamily="monospace" android:textSize="11sp"
            android:letterSpacing="0.1" android:text="LAB" android:background="@drawable/bg_btn"
            android:textColor="@color/text_dim"/>
        <Space android:layout_width="7dp" android:layout_height="1dp"/>
        <TextView android:id="@+id/tabStats" android:layout_width="0dp" android:layout_height="38dp"
            android:layout_weight="1" android:gravity="center" android:clickable="true"
            android:focusable="true" android:fontFamily="monospace" android:textSize="11sp"
            android:letterSpacing="0.1" android:text="STATS" android:background="@drawable/bg_btn"
            android:textColor="@color/text_dim"/>
        <Space android:layout_width="7dp" android:layout_height="1dp"/>
        <TextView android:id="@+id/buyBtn" android:layout_width="50dp" android:layout_height="38dp"
            android:gravity="center" android:clickable="true" android:focusable="true"
            android:fontFamily="monospace" android:textSize="12sp" android:text="×1"
            android:background="@drawable/bg_btn" android:textColor="@color/text_dim"/>
    </LinearLayout>

    <ListView android:id="@+id/list" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:divider="@color/line" android:dividerHeight="1dp"
        android:overScrollMode="never" android:scrollbars="none"/>
</LinearLayout>
